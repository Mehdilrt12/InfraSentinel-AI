# Relative same-origin defaults work behind the provided Nginx proxy in Docker
# and prevent a LAN browser from calling its own localhost.
VITE_API_URL=/api
# Optional only when a deployment also authorizes this exact origin in its CSP.
# Prefer the same-origin /ws proxy supplied by Docker.
# VITE_WS_URL=wss://monitoring.example.org/ws/events/
VITE_PUBLIC_REGISTRATION_ENABLED=false
VITE_POLL_INTERVAL_MS=30000
VITE_AGENT_INSTALLER_URL=
