# Copy to .env.production on the VPS. Never commit the populated file.
APP_DOMAIN=monitoring.example.com
ACME_EMAIL=admin@example.com
HTTP_BIND_ADDRESS=0.0.0.0
HTTPS_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

# Required independent secrets; intentionally empty.
DJANGO_SECRET_KEY=
JWT_SIGNING_KEY=
POSTGRES_PASSWORD=

ALLOWED_HOSTS=monitoring.example.com
FRONTEND_URL=https://monitoring.example.com
CORS_ALLOWED_ORIGINS=https://monitoring.example.com
CSRF_TRUSTED_ORIGINS=https://monitoring.example.com

POSTGRES_DB=infrasentinel
POSTGRES_USER=infrasentinel
POSTGRES_SSLMODE=disable
POSTGRES_CONN_MAX_AGE=60

INFRASENTINEL_IMAGE_TAG=production
PUBLIC_REGISTRATION_ENABLED=false
VITE_PUBLIC_REGISTRATION_ENABLED=false
CELERY_WORKER_CONCURRENCY=2
CELERY_TASK_TIME_LIMIT=900
CELERY_TASK_SOFT_TIME_LIMIT=840
LOG_LEVEL=INFO
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

DEFAULT_FROM_EMAIL=InfraSentinel <noreply@example.com>
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=30

SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
CONNECTOR_ALLOWED_HOSTS=
WEBSOCKET_SESSION_MAX_SECONDS=900
VITE_API_URL=/api
VITE_ENABLE_SOURCEMAPS=false
