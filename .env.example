# Copy this file to .env before running Docker Compose.
# Required secrets are intentionally empty: generate independent values locally.
DJANGO_SECRET_KEY=
JWT_SIGNING_KEY=
POSTGRES_PASSWORD=

POSTGRES_DB=infrasentinel
POSTGRES_USER=infrasentinel
POSTGRES_SSLMODE=disable
POSTGRES_CONN_MAX_AGE=60
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=5432
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_HOST_PORT=6379

# Loopback is the safe default. Run
#   ./scripts/prepare-local-compose-env.ps1 -Lan
# to detect the active IPv4 and prepare a non-versioned LAN configuration.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1,api
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DJANGO_DEBUG=false
PUBLIC_REGISTRATION_ENABLED=false
VITE_PUBLIC_REGISTRATION_ENABLED=false
API_DOCS_PUBLIC=false
CELERY_WORKER_CONCURRENCY=2
CELERY_TASK_TIME_LIMIT=900
CELERY_TASK_SOFT_TIME_LIMIT=840
LOG_LEVEL=INFO

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=InfraSentinel <noreply@infrasentinel.local>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=30

SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
JWT_REFRESH_COOKIE_SECURE=false
JWT_REFRESH_COOKIE_SAMESITE=Strict
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
TRUST_X_FORWARDED_PROTO=false
TRUSTED_PROXY_COUNT=1

CONNECTOR_ALLOWED_HOSTS=
ALLOW_INSECURE_CONNECTOR_TLS=false
WEBSOCKET_SESSION_MAX_SECONDS=900
INFRASENTINEL_IMAGE_TAG=local
