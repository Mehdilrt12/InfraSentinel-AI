DJANGO_SECRET_KEY=replace-with-a-long-random-secret
JWT_SIGNING_KEY=replace-with-an-independent-64-character-random-secret
DJANGO_DEBUG=false
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
FRONTEND_URL=http://127.0.0.1:5173
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=5173

# PostgreSQL target. Set DATABASE_ENGINE=sqlite only for local tests.
DATABASE_ENGINE=postgresql
POSTGRES_DB=infrasentinel
POSTGRES_USER=infrasentinel
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
POSTGRES_CONN_MAX_AGE=0
POSTGRES_CONN_HEALTH_CHECKS=true
POSTGRES_POOL_ENABLED=true
POSTGRES_POOL_MIN_SIZE=0
POSTGRES_POOL_MAX_SIZE=20
POSTGRES_POOL_TIMEOUT=10
POSTGRES_POOL_MAX_IDLE=60
SQLITE_DB_PATH=

REDIS_URL=redis://127.0.0.1:6379/0
CACHE_URL=redis://127.0.0.1:6379/2
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_TIME_LIMIT=900
CELERY_TASK_SOFT_TIME_LIMIT=840
ML_MODEL_DIR=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=InfraSentinel <noreply@infrasentinel.local>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=30
NOTIFICATION_SENDING_TIMEOUT_SECONDS=300

# Local HTTP defaults. Enable these only behind a correctly configured HTTPS proxy.
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
JWT_REFRESH_COOKIE_SECURE=false
JWT_REFRESH_COOKIE_SAMESITE=Strict
TRUSTED_PROXY_COUNT=0
TRUST_X_FORWARDED_PROTO=false
DATA_UPLOAD_MAX_MEMORY_SIZE=2621440
FILE_UPLOAD_MAX_MEMORY_SIZE=2621440
AUTH_LOGIN_IP_RATE=10/min
AUTH_LOGIN_ACCOUNT_RATE=5/min
REGISTRATION_RATE=5/hour
AGENT_ENROLLMENT_RATE=10/min
AGENT_REQUEST_RATE=120/min
CONNECTOR_ALLOWED_HOSTS=
ALLOW_INSECURE_CONNECTOR_TLS=false
WEBSOCKET_SESSION_MAX_SECONDS=900
LOG_LEVEL=INFO

# true expose le contrat sans authentification; false le réserve aux ADMIN.
API_DOCS_PUBLIC=false
PUBLIC_REGISTRATION_ENABLED=false
