# Copy to a protected secret store; never commit populated values.
DJANGO_SECRET_KEY=<generate-at-least-64-random-characters>
JWT_SIGNING_KEY=<generate-an-independent-64-character-random-key>
DJANGO_DEBUG=false
ALLOWED_HOSTS=api.infrasentinel.example
FRONTEND_URL=https://infrasentinel.example
CORS_ALLOWED_ORIGINS=https://infrasentinel.example
CSRF_TRUSTED_ORIGINS=https://infrasentinel.example

DATABASE_ENGINE=postgresql
POSTGRES_DB=<database-name>
POSTGRES_USER=<least-privilege-role>
POSTGRES_PASSWORD=<secret-store-reference-or-injected-secret>
POSTGRES_HOST=<postgres-host>
POSTGRES_PORT=5432
POSTGRES_SSLMODE=verify-full

REDIS_URL=rediss://:<password>@<redis-host>:6379/0
CACHE_URL=rediss://:<password>@<redis-host>:6379/2
CELERY_BROKER_URL=rediss://:<password>@<redis-host>:6379/0
CELERY_RESULT_BACKEND=rediss://:<password>@<redis-host>:6379/1
CELERY_TASK_ALWAYS_EAGER=false

SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
JWT_REFRESH_COOKIE_SECURE=true
JWT_REFRESH_COOKIE_SAMESITE=Strict
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=false
TRUST_X_FORWARDED_PROTO=true
TRUSTED_PROXY_COUNT=1

API_DOCS_PUBLIC=false
PUBLIC_REGISTRATION_ENABLED=false
ALLOW_INSECURE_CONNECTOR_TLS=false
WEBSOCKET_SESSION_MAX_SECONDS=900
CONNECTOR_ALLOWED_HOSTS=*.infrastructure.example
DATA_UPLOAD_MAX_MEMORY_SIZE=2621440
FILE_UPLOAD_MAX_MEMORY_SIZE=2621440
AUTH_LOGIN_IP_RATE=10/min
AUTH_LOGIN_ACCOUNT_RATE=5/min
REGISTRATION_RATE=5/hour
AGENT_ENROLLMENT_RATE=10/min
AGENT_REQUEST_RATE=120/min

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=InfraSentinel <noreply@infrasentinel.example>
EMAIL_HOST=<smtp-host>
EMAIL_PORT=587
EMAIL_HOST_USER=<smtp-user>
EMAIL_HOST_PASSWORD=<secret-store-reference-or-injected-secret>
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=30
LOG_LEVEL=INFO
